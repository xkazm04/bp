{
  "$comment": "rules-1 gate cases: the behaviour every reader of bp-rules.json that enforces it must reproduce (bp's scan/rules.ts gate and grantFor; a Personas port, docs/concepts/rules-personas-adoption.md). Each case: the live rules, an act, `now`, and what the gate answers: the held item ids with the order that holds each, the order that refuses the whole act (or null), or for a grant check the grant that covers it (or null). scripts/check-rules.ts runs every case against bp's gate; a port runs the same file.",
  "version": 1,
  "rules": {
    "hold-pay": { "id": "O-1", "kind": "hold", "text": "Hold payments", "by": "user:owner", "at": "2026-10-20T10:00:00Z", "scope": { "kind": "room", "id": "pay", "label": "Payments", "features": ["card", "refund"] } },
    "only-book": { "id": "O-2", "kind": "only", "text": "Only security in booking", "by": "user:owner", "at": "2026-10-20T10:00:00Z", "scope": { "kind": "room", "id": "book", "label": "Booking", "features": ["book"] }, "lenses": ["security"] },
    "cap-opus": { "id": "O-3", "kind": "cap", "text": "No Opus builds above medium", "by": "user:owner", "at": "2026-10-20T10:00:00Z", "scope": { "kind": "all", "label": "Everything", "features": [] }, "maxEffort": "medium", "model": "opus" },
    "hold-expired": { "id": "O-4", "kind": "hold", "text": "Expired", "by": "user:owner", "at": "2026-10-20T08:00:00Z", "scope": { "kind": "feature", "id": "quiz", "label": "Quiz", "features": ["quiz"] }, "expiresAt": "2026-10-20T11:00:00Z" },
    "hold-revoked": { "id": "O-5", "kind": "hold", "text": "Revoked", "by": "user:owner", "at": "2026-10-20T08:00:00Z", "scope": { "kind": "feature", "id": "quiz", "label": "Quiz", "features": ["quiz"] }, "revokedAt": "2026-10-20T09:00:00Z", "revokedBy": "user:owner" },
    "grant-backlog": { "id": "G-1", "kind": "grant", "text": "Agents may approve backlog findings", "by": "user:owner", "at": "2026-10-20T10:00:00Z", "scope": { "kind": "all", "label": "Everything", "features": [] }, "minTier": 3, "expiresAt": "2026-10-21T10:00:00Z" }
  },
  "cases": [
    { "name": "a hold leaves out what it covers; the rest goes", "rules": ["hold-pay"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "a", "feature": "card", "lens": "design" }, { "id": "b", "feature": "quiz", "lens": "design" }] },
      "expect": { "held": { "a": "O-1" }, "refused": null } },
    { "name": "all items held: the first holding order refuses the act", "rules": ["hold-pay"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.dispatch", "items": [{ "id": "a", "feature": "card", "lens": "design" }, { "id": "r", "feature": "refund", "lens": "security" }] },
      "expect": { "held": { "a": "O-1", "r": "O-1" }, "refused": "O-1" } },
    { "name": "only: another lens is held, its own lens goes", "rules": ["only-book"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "c", "feature": "book", "lens": "design" }, { "id": "s", "feature": "book", "lens": "security" }] },
      "expect": { "held": { "c": "O-2" }, "refused": null } },
    { "name": "cap: above its effort on its model is held", "rules": ["cap-opus"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }], "model": "opus", "effort": "xhigh" },
      "expect": { "held": { "q": "O-3" }, "refused": "O-3" } },
    { "name": "cap: at its effort goes", "rules": ["cap-opus"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }], "model": "opus", "effort": "medium" },
      "expect": { "held": {}, "refused": null } },
    { "name": "cap: another model goes", "rules": ["cap-opus"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }], "model": "sonnet", "effort": "xhigh" },
      "expect": { "held": {}, "refused": null } },
    { "name": "cap: a build with no effort (a plain dispatch) is never capped", "rules": ["cap-opus"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "dispatch", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }] },
      "expect": { "held": {}, "refused": null } },
    { "name": "expired and revoked orders hold nothing", "rules": ["hold-expired", "hold-revoked"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }] },
      "expect": { "held": {}, "refused": null } },
    { "name": "an order before its expiry holds", "rules": ["hold-expired"], "now": "2026-10-20T10:30:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "q", "feature": "quiz", "lens": "design" }] },
      "expect": { "held": { "q": "O-4" }, "refused": "O-4" } },
    { "name": "a scan inside a held place is refused", "rules": ["hold-pay"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "scan", "tool": "scan.place", "lens": "design", "scope": { "kind": "feature", "id": "refund", "label": "Refund", "features": ["refund"] } },
      "expect": { "held": {}, "refused": "O-1" } },
    { "name": "a scan outside every held place goes", "rules": ["hold-pay"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "scan", "tool": "scan.place", "lens": "design", "scope": { "kind": "feature", "id": "quiz", "label": "Quiz", "features": ["quiz"] } },
      "expect": { "held": {}, "refused": null } },
    { "name": "an all-scan touches every place", "rules": ["hold-pay"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "scan", "tool": "scan.place", "lens": "design", "scope": { "kind": "all", "label": "Everything", "features": [] } },
      "expect": { "held": {}, "refused": "O-1" } },
    { "name": "only: its own lens may scan its place", "rules": ["only-book"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "scan", "tool": "scan.place", "lens": "security", "scope": { "kind": "room", "id": "book", "label": "Booking", "features": ["book"] } },
      "expect": { "held": {}, "refused": null } },
    { "name": "a cap never refuses a scan", "rules": ["cap-opus"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "scan", "tool": "scan.place", "lens": "design", "scope": { "kind": "all", "label": "Everything", "features": [] } },
      "expect": { "held": {}, "refused": null } },
    { "name": "grants never hold or refuse", "rules": ["grant-backlog"], "now": "2026-10-20T12:00:00Z",
      "act": { "kind": "build", "tool": "wave.compose", "items": [{ "id": "a", "feature": "card", "lens": "design" }] },
      "expect": { "held": {}, "refused": null } },
    { "name": "grant: a backlog finding is covered", "rules": ["grant-backlog"], "now": "2026-10-20T12:00:00Z",
      "grant": { "tool": "decision.answer", "items": [{ "feature": "card", "tier": 3 }] }, "expect": { "grant": "G-1" } },
    { "name": "grant: a stop-ship is not covered", "rules": ["grant-backlog"], "now": "2026-10-20T12:00:00Z",
      "grant": { "tool": "decision.answer", "items": [{ "feature": "card", "tier": 0 }] }, "expect": { "grant": null } },
    { "name": "grant: an untiered finding is not covered by a tier-bound grant", "rules": ["grant-backlog"], "now": "2026-10-20T12:00:00Z",
      "grant": { "tool": "decision.answer", "items": [{ "feature": "card" }] }, "expect": { "grant": null } },
    { "name": "grant: a tool it does not name is not covered", "rules": ["grant-backlog"], "now": "2026-10-20T12:00:00Z",
      "grant": { "tool": "triage.set", "items": [{ "feature": "card", "tier": 3 }] }, "expect": { "grant": null } },
    { "name": "grant: after its expiry nothing is covered", "rules": ["grant-backlog"], "now": "2026-10-21T10:00:01Z",
      "grant": { "tool": "decision.answer", "items": [{ "feature": "card", "tier": 3 }] }, "expect": { "grant": null } }
  ]
}
