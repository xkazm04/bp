# Blender script; run with blender -b -P scripts/art/studio-kit/render_kits.bpy -- <repo-root> <asset-id> [<out-root>]
"""Evidence for a studio density kit (build_kits.bpy), judged IN CONTEXT as render_context.bpy judges the props: EEVEE on
the GPU under a rig like the UE studio's (near-black blue walls #0A0F18, a cool table glow #BFE8FF from below and in
front, a warm practical #FFB547, a grey-blue room fill), no shadows and no screen-space AO, so what grounds a prop is its
own bake. Writes <out-root>/<asset-id>/evidence/context.jpg (a three-quarter view in its setting) and
evidence/target-compare.jpg (the concept's crop of the same element beside a render framed like it)."""
import bpy, math, os, sys
import numpy as np
from mathutils import Vector

ARGS = sys.argv[sys.argv.index('--') + 1:]
REPO, ASSET = ARGS[:2]
OUT_ROOT = ARGS[2] if len(ARGS) > 2 else os.path.join(REPO, 'apps', 'vr', 'ArtSource')
OUT = os.path.join(OUT_ROOT, ASSET)
EV = os.path.join(OUT, 'evidence')
os.makedirs(EV, exist_ok=True)
CONCEPT = os.path.join(REPO, 'docs', 'concepts', 'vr-light-table', 'target-light-table.jpg')
# the concept's crop of each element (x0, y0, x1, y1 in the 1376 x 768 target)
CROPS = {'studio-wall-kit': (0, 0, 300, 170), 'studio-desk-clutter': (0, 180, 230, 330), 'studio-architecture': (1080, 0, 1376, 210)}


def lin(h):
    c = [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    return tuple((x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4) for x in c)


def flat(name, hexc, rough=0.7, emit=None, strength=1.0):
    m = bpy.data.materials.new(name)
    b = m.node_tree.nodes['Principled BSDF']
    b.inputs['Base Color'].default_value = (*lin(hexc), 1)
    b.inputs['Roughness'].default_value = rough
    if emit:
        b.inputs['Emission Color'].default_value = (*lin(emit), 1)
        b.inputs['Emission Strength'].default_value = strength
    return m


def box(x0, x1, y0, y1, z0, z1, mat):
    bpy.ops.mesh.primitive_cube_add(size=1, location=((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2))
    o = bpy.context.object
    o.scale = (x1 - x0, y1 - y0, z1 - z0)
    o.data.materials.append(mat)
    return o


def light(kind, loc, watts, hexc, size=0.3, aim=None):
    bpy.ops.object.light_add(type=kind, location=loc)
    L = bpy.context.object
    L.data.energy = watts
    L.data.color = lin(hexc)
    L.data.use_shadow = False
    if kind == 'AREA':
        L.data.size = size
    if aim:
        L.rotation_euler = (Vector(aim) - Vector(loc)).to_track_quat('-Z', 'Y').to_euler()
    return L


bpy.ops.wm.read_factory_settings(use_empty=True)
sc = bpy.context.scene
sc.render.engine = 'BLENDER_EEVEE'
sc.eevee.taa_render_samples = 64
sc.view_settings.view_transform = 'AgX'
sc.view_settings.look = 'AgX - Medium High Contrast'
w = bpy.data.worlds.new('w'); sc.world = w
w.node_tree.nodes['Background'].inputs['Color'].default_value = (*lin('#05070C'), 1)
w.node_tree.nodes['Background'].inputs['Strength'].default_value = 0.6
bpy.ops.import_scene.gltf(filepath=os.path.join(OUT, 'final.glb'))
obs = {o.name: o for o in sc.objects if o.type == 'MESH'}
wall = flat('wall', '#0A0F18', 0.7)
desk = flat('desk', '#14110F', 0.8)

if ASSET == 'studio-wall-kit':
    box(-1.6, 1.6, 0.0, 0.1, -0.9, 2.2, wall)
    for o in obs.values():
        o.location = (0, 0, 0.0)
    light('AREA', (0.2, -1.6, -0.4), 70, '#BFE8FF', 2.0, aim=(0, 0, 0.6))          # the table's glow, low and in front
    light('POINT', (-1.3, -0.8, 0.6), 18, '#FFB547', 0.05)                          # the desk lamp's warm practical
    light('AREA', (0.4, -2.0, 2.4), 40, '#96A5BE', 2.5, aim=(0, 0, 0.6))            # room fill
    views = {'context': ((1.1, -3.6, 1.0), (0.0, 0.0, 0.58), 40), 'compare': ((-0.3, -2.1, 0.75), (-0.2, 0.0, 0.62), 34)}
elif ASSET == 'studio-desk-clutter':
    box(-0.6, 0.6, -0.4, 0.4, -0.04, 0.0, desk)
    box(-1.5, 1.5, 0.45, 0.55, -0.8, 2.0, wall)
    light('AREA', (0.6, -1.4, 0.2), 45, '#BFE8FF', 1.5, aim=(0, 0, 0.1))
    light('POINT', (-0.55, -0.1, 0.45), 14, '#FFB547', 0.05)
    light('AREA', (0.0, -1.2, 1.8), 25, '#96A5BE', 2.0, aim=(0, 0, 0))
    views = {'context': ((0.9, -1.2, 0.75), (0.0, 0.0, 0.14), 36), 'compare': ((-0.4, -1.3, 0.55), (0.0, 0.0, 0.12), 34)}
else:
    # the back wall round the opening (the window frame's pivot at the opening's bottom centre), the city as an emissive
    # band behind it, the pendant over a desk to the right
    for x0, x1, z0, z1 in ((-2.0, -0.75, -0.2, 3.0), (0.75, 2.0, -0.2, 3.0), (-0.75, 0.75, -0.2, 0.0), (-0.75, 0.75, 2.6, 3.0)):
        box(x0, x1, 0.0, 0.1, z0, z1, wall)
    city = flat('city', '#0B1426', 0.8, emit='#1B2C52', strength=1.2)
    box(-3.0, 3.0, 1.2, 1.25, -0.5, 3.5, city)
    box(-2.0, 2.0, -3.0, 0.1, -0.21, -0.2, wall)
    obs['pendant_lamp'].location = (0.85, -0.9, 2.8)
    light('AREA', (0.0, -2.5, 0.6), 60, '#BFE8FF', 2.0, aim=(0, 0, 1.2))
    light('AREA', (0.0, 0.6, 1.4), 30, '#5A7DC8', 1.5, aim=(0, 0, 1.2))           # city spill through the window
    light('POINT', (0.85, -0.9, 1.75), 8, '#FFC27A', 0.04)                         # the pendant's own bulb
    views = {'context': ((-1.6, -5.2, 1.5), (0.35, 0.0, 1.5), 42), 'compare': ((-1.2, -4.2, 1.3), (0.2, 0.0, 1.6), 40)}

cam_d = bpy.data.cameras.new('c'); cam = bpy.data.objects.new('c', cam_d); sc.collection.objects.link(cam); sc.camera = cam


def shot(name, loc, tgt, fov, wpx, hpx):
    cam.location = loc
    cam.rotation_euler = (Vector(tgt) - Vector(loc)).to_track_quat('-Z', 'Y').to_euler()
    cam_d.sensor_fit = 'HORIZONTAL'; cam_d.sensor_width = 36; cam_d.lens = 18 / math.tan(math.radians(fov) / 2)
    sc.render.resolution_x, sc.render.resolution_y = wpx, hpx
    p = os.path.join(EV, name + '.png')
    sc.render.filepath = p; sc.render.image_settings.file_format = 'PNG'
    bpy.ops.render.render(write_still=True)
    return p


def load(p):
    im = bpy.data.images.load(p); wd, ht = im.size
    a = np.array(im.pixels[:], np.float32).reshape(ht, wd, 4)[:, :, :3]; bpy.data.images.remove(im); return a


def save_jpg(a, path):
    h, wd, _ = a.shape
    o = bpy.data.images.new('o', wd, h)
    o.pixels.foreach_set(np.concatenate([a, np.ones((h, wd, 1), np.float32)], axis=2).ravel())
    o.filepath_raw = path; o.file_format = 'JPEG'; o.save(); bpy.data.images.remove(o)


p = shot('context', *views['context'], 1280, 720)
save_jpg(load(p), os.path.join(EV, 'context.jpg')); os.remove(p)
x0, y0, x1, y1 = CROPS[ASSET]
T = load(CONCEPT)
H = T.shape[0]
crop = T[H - y1:H - y0, x0:x1]                                   # pixels are bottom-up
sc_ = 3
crop = np.repeat(np.repeat(crop, sc_, 0), sc_, 1)
p = shot('compare', *views['compare'], crop.shape[1], crop.shape[0])
r = load(p); os.remove(p)
save_jpg(np.concatenate([crop, np.full((crop.shape[0], 8, 3), 0.02, np.float32), r], axis=1), os.path.join(EV, 'target-compare.jpg'))
print('RENDER', ASSET, 'done')
