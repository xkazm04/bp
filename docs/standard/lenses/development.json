{
  "$schema": "lens-manifest/1",
  "id": "development",
  "version": "1.1.0",
  "name": "Development",
  "short": "DEV",
  "description": "Build progress, agent authorship, human review, unit coverage and tech debt. Measured: code size, bundle share, probed latency, duplication, test ratio and standards met.",
  "reader": { "role": "development", "density": "dense" },
  "fields": [
    { "key": "status", "label": "Status", "type": "enum",
      "values": ["not-started", "in-progress", "in-review", "merged", "done"],
      "description": "Where the code is. The lens does not apply before any code exists." },
    { "key": "progressPct", "label": "Progress", "type": "percent", "headline": true },
    { "key": "aiAuthoredPct", "label": "Agent-authored", "type": "percent" },
    { "key": "humanReviewed", "label": "Human reviewed", "type": "boolean" },
    { "key": "openPRs", "label": "Open PRs", "type": "integer", "min": 0 },
    { "key": "unitCoveragePct", "label": "Unit coverage", "type": "percent" },
    { "key": "techDebt", "label": "Tech debt", "type": "integer", "min": 0, "max": 3,
      "description": "0 none, 1 some, 2 heavy, 3 severe." },
    { "key": "linesOfCode", "label": "Lines of code", "type": "integer", "min": 0 },
    { "key": "lastCommit", "label": "Last commit", "type": "date" },
    { "key": "stalled", "label": "Stalled", "type": "boolean" },
    { "key": "loc", "label": "Code size", "type": "integer", "unit": "lines", "min": 0, "metric": { "better": "down", "method": "static" } },
    { "key": "files", "label": "Files", "type": "integer", "min": 0, "metric": { "better": "down", "method": "static" } },
    { "key": "bundleKb", "label": "Bundle share", "type": "number", "unit": "KB", "min": 0, "metric": { "better": "down", "method": "static" },
      "description": "The feature's share of the shipped client bundle. Omitted when the build names no stats file." },
    { "key": "depCount", "label": "Dependencies", "type": "integer", "min": 0, "metric": { "better": "down", "method": "static" } },
    { "key": "p50Ms", "label": "p50 latency", "type": "number", "unit": "ms", "min": 0, "metric": { "better": "down", "method": "probe" } },
    { "key": "p95Ms", "label": "p95 latency", "type": "number", "unit": "ms", "min": 0, "metric": { "better": "down", "method": "probe", "target": 500, "warn_at": 1000 },
      "description": "Probed against a local build. The budget is 1000 ms; above it the lens is at watch." },
    { "key": "dupSites", "label": "Duplicated sites", "type": "integer", "min": 0, "metric": { "better": "down", "method": "judgement" },
      "description": "Places that re-implement something a shared module already does." },
    { "key": "testRatioPct", "label": "Test ratio", "type": "percent", "metric": { "better": "up", "method": "static" },
      "description": "Test lines as a share of source lines." },
    { "key": "standardsPct", "label": "Standards met", "type": "percent", "metric": { "better": "up", "method": "judgement" },
      "description": "Share of the applicable registry and house standards the code conforms to." }
  ],
  "health": {
    "applies_when": { "not": { "field": "status", "eq": "not-started" } },
    "rules": [
      { "when": { "all": [ { "field": "humanReviewed", "eq": false }, { "field": "status", "in": ["merged", "done"] } ] },
        "health": "bad", "reason": "Shipped without human review", "short": "Unreviewed AI code" },
      { "when": { "field": "techDebt", "eq": 3 }, "health": "bad", "reason": "Severe tech debt", "short": "Severe tech debt" },
      { "when": { "field": "stalled", "eq": true }, "health": "watch", "reason": "Stalled since {lastCommit}", "short": "Stalled" },
      { "when": { "field": "techDebt", "eq": 2 }, "health": "watch", "reason": "Heavy tech debt", "short": "Tech debt" },
      { "when": { "field": "unitCoveragePct", "lt": 40 }, "health": "watch", "reason": "Unit coverage {unitCoveragePct}%", "short": "Coverage {unitCoveragePct}%" },
      { "when": { "field": "p95Ms", "gt": 1000 }, "health": "watch", "reason": "p95 {p95Ms} ms, over the 1000 ms budget", "short": "p95 {p95Ms} ms" }
    ],
    "default": "good",
    "rollup": { "method": "share", "watch": 0.25, "bad": 0.15 }
  },
  "presentation": {
    "glyph": "brackets",
    "line": "comb",
    "accent": { "dark": "#a9b5ff", "light": "#3d48c9" },
    "evidence": ["progressPct", "aiAuthoredPct", "unitCoveragePct", "openPRs"],
    "measures": "progressPct"
  }
}
