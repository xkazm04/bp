# Blender script: ortho side view of a raw lamp GLB (from +X, right = +Y) for reading joint positions. -- <glb> <out.png>
import bpy, sys
a = sys.argv[sys.argv.index('--') + 1:]
bpy.ops.wm.read_factory_settings(use_empty=True)
bpy.ops.import_scene.gltf(filepath=a[0], merge_vertices=True)
s = bpy.context.scene; s.render.engine = 'BLENDER_EEVEE'; s.render.resolution_x = s.render.resolution_y = 1000
w = bpy.data.worlds.new('w'); s.world = w; w.use_nodes = True; w.node_tree.nodes['Background'].inputs[0].default_value = (.5, .5, .5, 1)
l = bpy.data.objects.new('l', bpy.data.lights.new('l', 'SUN')); l.data.energy = 3; l.rotation_euler = (0.6, 0.2, 0.9); s.collection.objects.link(l)
cam = bpy.data.objects.new('c', bpy.data.cameras.new('c')); s.collection.objects.link(cam); s.camera = cam
cam.data.type = 'ORTHO'; cam.data.ortho_scale = 1.1; cam.location = (3, 0, 0); cam.rotation_euler = (1.5707963, 0, 1.5707963)
s.render.filepath = a[1]; bpy.ops.render.render(write_still=True)
