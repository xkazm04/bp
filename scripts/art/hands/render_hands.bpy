# Check render of the capture hands (build_hands.bpy): EEVEE on the GPU, a stand-in table (a glowing blueprint-blue
# sheet at z = 0 whose near edge is y = 0, as the capture frame has it), the first-person eye of the target pose, the
# table's cool light from below and a warm key from the far side; then the target beside it, same size.
#   blender -b -P scripts/art/hands/render_hands.bpy -- <repo> <work>
import bpy
import math
import os
import sys
import numpy as np
from mathutils import Vector

argv = sys.argv[sys.argv.index('--') + 1:]
REPO, WORK = argv[0], argv[1]
OUT = os.path.join(REPO, 'apps', 'vr', 'ArtSource', 'hands-capture')
EV = os.path.join(OUT, 'evidence')
os.makedirs(EV, exist_ok=True)
bpy.ops.wm.open_mainfile(filepath=os.path.join(WORK, 'hands.blend'))
scene = bpy.context.scene
scene.render.engine = 'BLENDER_EEVEE'
scene.eevee.taa_render_samples = 64
scene.view_settings.view_transform = 'AgX'
w = bpy.data.worlds.new('w'); scene.world = w; w.use_nodes = True
w.node_tree.nodes['Background'].inputs['Color'].default_value = (0.004, 0.005, 0.009, 1)

# the table: the sheet glows blueprint blue (the light box), a dark rim band in front of it
bpy.ops.mesh.primitive_plane_add(size=1, location=(0, 0.45, 0)); sheet = bpy.context.object
sheet.scale = (1.6, 0.9, 1)
m = bpy.data.materials.new('sheet'); m.use_nodes = True
bs = m.node_tree.nodes['Principled BSDF']
bs.inputs['Base Color'].default_value = (0.02, 0.06, 0.25, 1); bs.inputs['Emission Color'].default_value = (0.03, 0.10, 0.45, 1)
bs.inputs['Emission Strength'].default_value = 1.2; bs.inputs['Roughness'].default_value = 0.6
sheet.data.materials.append(m)
bpy.ops.mesh.primitive_cube_add(size=1, location=(0, -0.02, -0.005)); rim = bpy.context.object
rim.scale = (1.7, 0.03, 0.012)
rm = bpy.data.materials.new('rim'); rm.use_nodes = True
rb = rm.node_tree.nodes['Principled BSDF']; rb.inputs['Base Color'].default_value = (0.6, 0.62, 0.65, 1); rb.inputs['Metallic'].default_value = 0.8
rb.inputs['Emission Color'].default_value = (0.8, 0.9, 1.0, 1); rb.inputs['Emission Strength'].default_value = 6.0   # the edge light strip
rim.data.materials.append(rm)

def light(name, kind, loc, energy, color, size=0.5, rot=(0, 0, 0)):
    d = bpy.data.lights.new(name, kind); d.energy = energy; d.color = color
    if kind == 'AREA': d.size = size
    o = bpy.data.objects.new(name, d); scene.collection.objects.link(o); o.location = loc; o.rotation_euler = rot
    return o
light('table', 'AREA', (0, 0.35, 0.003), 14, (0.45, 0.65, 1.0), size=1.4, rot=(math.radians(180), 0, 0))   # up from the sheet
light('warm', 'AREA', (0.1, 1.0, 0.7), 20, (1.0, 0.75, 0.5), size=0.6, rot=(math.radians(-130), 0, 0))
light('fill', 'AREA', (-0.8, -0.6, 0.8), 4, (0.6, 0.7, 1.0), size=1.0, rot=(math.radians(50), 0, math.radians(-50)))

cd = bpy.data.cameras.new('c'); cam = bpy.data.objects.new('c', cd); scene.collection.objects.link(cam); scene.camera = cam
cam.location = (0.0, -0.30, 0.40)
cam.rotation_euler = (Vector((0.0, 0.16, 0.0)) - cam.location).to_track_quat('-Z', 'Y').to_euler()
cd.sensor_width = 36; cd.lens = 36 / (2 * math.tan(math.radians(66) / 2))
scene.render.resolution_x, scene.render.resolution_y = 1376, 768
raw = os.path.join(WORK, 'hands_raw.png')
scene.render.filepath = raw; scene.render.image_settings.file_format = 'PNG'
bpy.ops.render.render(write_still=True)

def load(p):
    im = bpy.data.images.load(p); wd, ht = im.size
    a = np.array(im.pixels[:], dtype=np.float32).reshape(ht, wd, 4)[:, :, :3]; bpy.data.images.remove(im); return a
r = load(raw)
t = load(os.path.join(REPO, 'docs', 'concepts', 'vr-light-table', 'target-light-table.jpg'))
both = np.concatenate([t, np.full((t.shape[0], 8, 3), 0.02, np.float32), r], axis=1)
o = bpy.data.images.new('o', both.shape[1], both.shape[0])
o.pixels.foreach_set(np.concatenate([both, np.ones(both.shape[:2] + (1,), np.float32)], axis=2).ravel())
o.filepath_raw = os.path.join(EV, 'target-compare.jpg'); o.file_format = 'JPEG'; o.save()
# a close look at the pair from the same side, for the hand shapes and the skin
cam.location = (0.0, -0.32, 0.30)
cam.rotation_euler = (Vector((-0.02, 0.0, 0.05)) - cam.location).to_track_quat('-Z', 'Y').to_euler()
scene.render.resolution_x, scene.render.resolution_y = 1200, 675
scene.render.filepath = os.path.join(EV, 'closeup.png'); bpy.ops.render.render(write_still=True)
print('RENDER hands done')
