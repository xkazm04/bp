# Blender script (extension .bpy so scripts/check-python-deps.mjs does not read bpy/bmesh/mathutils as pip packages)
"""Builds the light table frame (apps/vr/ArtSource/light-table-frame) and scores the exported file.

Run:  blender -b -P scripts/art/light-table-frame/build_frame.bpy -- <repo-root> <work-dir> [<length-m> <depth-m> [<glow-strength> [<scans-dir>]]]
The defaults (1.20 x 0.80 m, glow 25) rebuild the first frame; spark vr-hands-zoom builds 1.80 x 0.90 with a dimmer strip.
Procedural only: no generated input, no GPU job. Metres, Blender Z-up, the glTF exporter writes Y-up.
Pivot is the floor centre. The top is 3 cm thick at the outer edge (lamp-agent's C-clamp grips a 3 cm edge). The glass is a
placeholder plane in its own slot for UE to replace; the glass and paper are procedural in UE (plan.md P4).
Spark vr-fidelity-40 finish (scripts/art/lib/finish.bpy): the rim is an aluminium extrusion (a grooved profile swept round
the outline, mitred), with corner caps and screw heads; square extrusion legs; every hard edge bevelled with hardened
normals; unique UVs and one 2048 px atlas baked on the CPU from Poly Haven CC0 scans (dark anodised aluminium worn bright
on its edges, so the edge light has something to catch). The glow strip and the glass keep their own flat slots.
<scans-dir> is the Poly Haven cache of scripts/art/lib/polyhaven.mjs (default <work-dir>/polyhaven).
Writes <work-dir>/score.json from a re-import of final.glb."""
import bpy, bmesh, math, os, sys, json, importlib.machinery
import numpy as np
from mathutils import Vector

ARGV = sys.argv[sys.argv.index('--') + 1:]
REPO, WORK = ARGV[:2]
OUT = os.path.join(REPO, 'apps', 'vr', 'ArtSource', 'light-table-frame')
BUDGET = 10000
RES = 2048
SCANS_DIR = ARGV[5] if len(ARGV) >= 6 else os.path.join(WORK, 'polyhaven')
os.makedirs(WORK, exist_ok=True)
lib = importlib.machinery.SourceFileLoader('finish', os.path.join(REPO, 'scripts', 'art', 'lib', 'finish.bpy')).load_module()

# bake slots; the shipped mesh has three: frame_atlas, frame_edge_glow, frame_glass_placeholder_REPLACE_IN_UE
SLOTS = ['rim', 'alu', 'steel', 'frame_edge_glow', 'frame_glass_placeholder_REPLACE_IN_UE']
GLOW_SLOT, GLASS_SLOT = SLOTS[3], SLOTS[4]
L, W = (float(ARGV[2]), float(ARGV[3])) if len(ARGV) >= 4 else (1.20, 0.80)   # top outline, x by y
TOP, T = 0.95, 0.03          # top surface height (wolf-plan W3.2 starts the table at 95 cm), edge thickness
BOT = TOP - T
R = 0.05                     # rim board width
LIP_H, LIP_W = 0.014, 0.02   # ledge the glass rests on
GLOW_H = 0.008             # strip top sits 6 mm under the rim top, so the 45 degree camera sees it past the rim
GLOW_W = LIP_W            # the strip covers the whole ledge
# emission strength (glTF KHR_materials_emissive_strength). The first frame's 25 bloomed into a white band under UE's fixed
# exposure (capture, 2026-10-24); the long frame passes a lower one, found by capture, as the fifth argument
GLOW_STRENGTH = float(ARGV[4]) if len(ARGV) >= 5 else 25.0
DARK_HEX = '#0A0F18'      # style-block.json palette role 'studio' (near-black blue); the block has no separate dark-metal value
GLOW_HEX = '#F4FAFF'


def srgb_to_lin(c):
    return tuple((x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4) for x in c)


def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def build():
    bpy.ops.wm.read_factory_settings(use_empty=True)
    sc = lib.Scans(SCANS_DIR)
    mats = [lib.surface('rim_bake', sc, tint='#262B33', scan='blue_metal_plate', var=0.25, rough=(0.5, 0.66), metal=1.0, nstr=0.2,
                        wear=dict(color='#9EA5AE', rough=0.3, metal=1.0, amount=0.4), grunge=0.05),
            lib.surface('alu_bake', sc, tint='#C9CDD2', scan='blue_metal_plate', var=0.15, rough=(0.26, 0.4), metal=1.0, nstr=0.15, grunge=0.06),
            lib.surface('steel_bake', sc, tint='#5A5F66', scan='blue_metal_plate', var=0.2, rough=(0.3, 0.45), metal=1.0, nstr=0.2, grunge=0.05),
            lib.placeholder(GLOW_SLOT + '_bake'), lib.placeholder(GLASS_SLOT + '_bake')]
    k = lib.Kit(SLOTS)
    # the rim: an extrusion profile (d inward from the outer edge, z up from the underside), 5 cm wide, 3 cm tall, with a
    # 6 mm groove on the outer face (the T-slot of an aluminium extrusion), swept round the outline with mitred corners
    rim = [(0, 0), (0, 0.012), (0.0035, 0.0125), (0.0035, 0.0175), (0, 0.018), (0, T), (R, T), (R, 0)]
    k.ring_frame(rim, L, W, BOT, 'rim', bevel=0.0015)
    k.ring_frame([(R - 0.001, 0), (R - 0.001, LIP_H), (R + LIP_W, LIP_H), (R + LIP_W, 0)], L, W, BOT, 'alu', bevel=0.001)       # ledge
    k.ring_frame([(R - 0.001, LIP_H), (R - 0.001, LIP_H + GLOW_H), (R + GLOW_W, LIP_H + GLOW_H), (R + GLOW_W, LIP_H)], L, W, BOT,
                 GLOW_SLOT, bevel=0.0)                                                                                          # strip
    # glass placeholder plane, inside the strip, at the top of the strip (one quad facing +Z, its own slot)
    gx, gy, gz = L / 2 - R - GLOW_W, W / 2 - R - GLOW_W, BOT + LIP_H + GLOW_H
    vs = [k.bm.verts.new(p) for p in ((-gx, -gy, gz), (gx, -gy, gz), (gx, gy, gz), (-gx, gy, gz))]
    f = k.bm.faces.new(vs)
    f.material_index = k.m(GLASS_SLOT)
    # corner caps: 2.5 mm L-plates over the rim's mitred corners, two screw heads on each arm
    cap, arm = 0.0025, 0.06
    for sx in (-1, 1):
        for sy in (-1, 1):
            pts = [(0, 0), (arm, 0), (arm, cap), (cap, cap), (cap, arm), (0, arm)]
            pts = [(sx * (L / 2 + cap - x), sy * (W / 2 + cap - y)) for x, y in pts]
            k.prism(pts, BOT + 0.002, T - 0.004, 'steel', bevel=0.0008)
            for a in (0.02, 0.045):
                for c, ax in ((Vector((sx * (L / 2 - a), sy * (W / 2 + cap), BOT + T / 2)), (0, sy, 0)),
                              (Vector((sx * (L / 2 + cap), sy * (W / 2 - a), BOT + T / 2)), (sx, 0, 0))):
                    k.lathe([(0, -0.001), (0.0032, -0.001), (0.0032, 0.0006), (0.0022, 0.0016), (0, 0.0019)], 12, base=c, axis=ax,
                            mat='steel', bevel=0.0)
    # apron under the top, inset 6 cm so a clamp grips the bare 3 cm edge
    ai = 0.06
    for s in (-1, 1):
        k.box((0, s * (W / 2 - ai - 0.01), BOT - 0.015), (L - 2 * ai, 0.02, 0.03), 'alu', bevel=0.0015)
        k.box((s * (L / 2 - ai - 0.01), 0, BOT - 0.015), (0.02, W - 2 * ai - 0.04, 0.03), 'alu', bevel=0.0015)
    # trestle: four 4 cm square extrusion legs, levelling feet, a lower rail on each side and end.
    # The legs stand 8.5 cm in from the sides; along the length they move in as it grows (8.5 cm at 1.20 m, 15 cm at 1.80 m)
    lx, ly = L / 2 - (0.085 + max(0.0, L - 1.20) * 0.108), W / 2 - 0.085
    for sx in (-1, 1):
        for sy in (-1, 1):
            k.box((sx * lx, sy * ly, (0.014 + BOT - 0.03) / 2), (0.04, 0.04, BOT - 0.03 - 0.014), 'rim', bevel=0.002)
            k.lathe([(0, 0), (0.024, 0), (0.026, 0.003), (0.026, 0.008), (0.01, 0.011), (0.008, 0.016), (0, 0.016)], 24,
                    base=(sx * lx, sy * ly, 0), mat='alu', bevel=0.001)
    for s in (-1, 1):
        k.box((0, s * ly, 0.22), (2 * lx - 0.04, 0.03, 0.04), 'rim', bevel=0.0015)
        k.box((s * lx, 0, 0.22), (0.03, 2 * ly - 0.04, 0.04), 'rim', bevel=0.0015)
    src = k.to_object('light-table-frame')
    for m in mats:
        src.data.materials.append(m)
    ob, fin = lib.finish(src, 'light-table-frame')
    fin['hard_edges_bevelled'] = k.hard_edges
    fin['hard_edges_sharp_by_design'] = k.sharp_edges
    td = lib.unwrap(ob, RES, [0, 1, 2], view=lib.VIEW_FREE)
    lib.fit_uv(ob, SLOTS.index(GLASS_SLOT), axes=(0, 1))
    folder = os.path.join(OUT, 'textures')
    for f_ in os.listdir(folder) if os.path.isdir(folder) else []:
        os.remove(os.path.join(folder, f_))                       # the 512 px tiles of the first build go; the atlas replaces them
    paths, bk = lib.bake(ob, RES, folder, 'frame_atlas', ao_distance=0.08)
    final = [lib.export_material('frame_atlas', tex=paths),
             lib.export_material(GLOW_SLOT, color=GLOW_HEX, rough=0.5, emit=GLOW_HEX, emit_strength=GLOW_STRENGTH),
             lib.export_material(GLASS_SLOT, color='#BFD8F0', rough=0.05, alpha=0.15)]
    lib.collapse_slots(ob, {0: 0, 1: 0, 2: 0, 3: 1, 4: 2}, final)
    os.makedirs(OUT, exist_ok=True)
    lib.export_glb(os.path.join(OUT, 'final.glb'), 'JPEG')
    json.dump({'finish': fin, 'texel': td, 'bake': bk, 'atlas_res': RES, 'scans': sc.provenance()}, open(os.path.join(WORK, 'finish.json'), 'w'), indent=1)
    print('FINISH', json.dumps(fin), json.dumps(td), json.dumps(bk))


def score():
    """Re-imports final.glb and measures it. glTF is Y-up, the importer converts back to Z-up."""
    bpy.ops.wm.read_factory_settings(use_empty=True)
    bpy.ops.import_scene.gltf(filepath=os.path.join(OUT, 'final.glb'))
    obs = [o for o in bpy.context.scene.objects if o.type == 'MESH']
    S = {'objects': [o.name for o in obs], 'mesh_objects': len(obs), 'outline_m': [L, W], 'glow_strength': GLOW_STRENGTH}
    ob = obs[0]
    me = ob.data
    S['tris'] = sum(len(p.vertices) - 2 for p in me.polygons)
    S['budget_tris'] = BUDGET
    S['uv_sets'] = len(me.uv_layers)
    S['materials'] = [m.name for m in me.materials]
    S['faces_per_slot'] = {m.name: sum(1 for p in me.polygons if p.material_index == i) for i, m in enumerate(me.materials)}
    bm = bmesh.new()
    bm.from_mesh(me)
    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=1e-6)       # the importer splits vertices at UV and normal seams
    bm.verts.ensure_lookup_table()
    S['vertices'] = len(bm.verts)
    seen, comps = set(), []
    for v in bm.verts:
        if v.index in seen:
            continue
        st, grp = [v], []
        seen.add(v.index)
        while st:
            x = st.pop()
            grp.append(x.index)
            for e in x.link_edges:
                o = e.other_vert(x)
                if o.index not in seen:
                    seen.add(o.index)
                    st.append(o)
        comps.append(grp)
    boxes = []
    for g in comps:
        q = np.array([bm.verts[i].co[:] for i in g])
        boxes.append((q.min(0), q.max(0)))
    touch = lambda a, b: all(a[0][i] <= b[1][i] + 1e-4 and b[0][i] <= a[1][i] + 1e-4 for i in range(3))
    S['components'] = len(comps)
    S['floaters'] = sum(1 for i, a in enumerate(boxes) if len(boxes) > 1 and not any(touch(a, b) for j, b in enumerate(boxes) if j != i))
    S['open_edges'] = sum(1 for e in bm.edges if len(e.link_faces) == 1)
    bm.free()
    co = np.array([(ob.matrix_world @ v.co)[:] for v in me.vertices])
    S['bounds_m'] = {'min': [round(float(x), 4) for x in co.min(0)], 'max': [round(float(x), 4) for x in co.max(0)],
                     'size_xyz': [round(float(x), 4) for x in co.max(0) - co.min(0)]}
    S['pivot_xy_centre_m'] = [round(float((co[:, 0].min() + co[:, 0].max()) / 2), 4), round(float((co[:, 1].min() + co[:, 1].max()) / 2), 4)]
    S['floor_z_m'] = round(float(co[:, 2].min()), 4)
    S['top_surface_z_m'] = round(float(co[:, 2].max()), 4)
    # the 3 cm edge: the vertices within 6 mm of the outer front (above the lower rails: the rim's front behind the 2.5 mm
    # corner caps); the bevels round the front
    # face's own corners, so the edge is measured over the rim's front, not on its one flat face
    edge = co[(np.abs(co[:, 1] - co[:, 1].min()) < 0.006) & (co[:, 2] > 0.5)]
    S['edge_thickness_m'] = round(float(edge[:, 2].max() - edge[:, 2].min()), 4)
    gi = [i for i, m in enumerate(me.materials) if 'glass' in m.name][0]
    gp = [p for p in me.polygons if p.material_index == gi]
    S['glass_faces_up'] = bool(gp) and all((ob.matrix_world.to_3x3() @ p.normal).z > 0.99 for p in gp)
    gco = np.array([(ob.matrix_world @ me.vertices[v].co)[:] for p in gp for v in p.vertices])
    S['glass_size_m'] = [round(float(x), 4) for x in gco.max(0) - gco.min(0)]
    S['glass_z_m'] = round(float(gco[:, 2].mean()), 4)
    S['material_has_textures'] = {m.name: sorted({n.image.name for n in m.node_tree.nodes if n.type == 'TEX_IMAGE'}) for m in me.materials}
    S['smooth_faces'] = round(sum(1 for p in me.polygons if p.use_smooth) / max(1, len(me.polygons)), 4)
    S.update(json.load(open(os.path.join(WORK, 'finish.json'))))
    json.dump(S, open(os.path.join(WORK, 'score.json'), 'w'), indent=1)
    print('SCORE', json.dumps(S))


if __name__ == '__main__':
    build()
    score()
    print('BUILD OK')
