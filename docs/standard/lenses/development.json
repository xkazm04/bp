{
  "$schema": "lens-manifest/1",
  "id": "development",
  "version": "1.0.0",
  "name": "Development",
  "short": "DEV",
  "description": "Build progress, agent authorship, human review, unit coverage and tech debt.",
  "reader": { "role": "development", "density": "dense" },
  "fields": [
    { "key": "status", "label": "Status", "type": "enum",
      "values": ["not-started", "in-progress", "in-review", "merged", "done"],
      "description": "Where the code is. The lens does not apply before any code exists." },
    { "key": "progressPct", "label": "Progress", "type": "percent", "headline": true },
    { "key": "aiAuthoredPct", "label": "Agent-authored", "type": "percent" },
    { "key": "humanReviewed", "label": "Human reviewed", "type": "boolean" },
    { "key": "openPRs", "label": "Open PRs", "type": "integer", "min": 0 },
    { "key": "unitCoveragePct", "label": "Unit coverage", "type": "percent" },
    { "key": "techDebt", "label": "Tech debt", "type": "integer", "min": 0, "max": 3,
      "description": "0 none, 1 some, 2 heavy, 3 severe." },
    { "key": "linesOfCode", "label": "Lines of code", "type": "integer", "min": 0 },
    { "key": "lastCommit", "label": "Last commit", "type": "date" },
    { "key": "stalled", "label": "Stalled", "type": "boolean" }
  ],
  "health": {
    "applies_when": { "not": { "field": "status", "eq": "not-started" } },
    "rules": [
      { "when": { "all": [ { "field": "humanReviewed", "eq": false }, { "field": "status", "in": ["merged", "done"] } ] },
        "health": "bad", "reason": "Shipped without human review" },
      { "when": { "field": "techDebt", "eq": 3 }, "health": "bad", "reason": "Severe tech debt" },
      { "when": { "field": "stalled", "eq": true }, "health": "watch", "reason": "Stalled since {lastCommit}" },
      { "when": { "field": "techDebt", "eq": 2 }, "health": "watch", "reason": "Heavy tech debt" },
      { "when": { "field": "unitCoveragePct", "lt": 40 }, "health": "watch", "reason": "Unit coverage {unitCoveragePct}%" }
    ],
    "default": "good",
    "rollup": { "method": "share", "watch": 0.25, "bad": 0.15 }
  },
  "presentation": {
    "glyph": "brackets",
    "line": "comb",
    "accent": { "dark": "#a9b5ff", "light": "#3d48c9" },
    "evidence": ["progressPct", "aiAuthoredPct", "unitCoveragePct", "openPRs"],
    "measures": "progressPct"
  }
}
