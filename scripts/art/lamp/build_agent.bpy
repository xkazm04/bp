# The lamp agent, scripted (fidelity sprint 2026-10-24): the white robotic lamp character of target-light-table.jpg, built
# from primitives with bevels and smooth shading instead of image-to-3D, from the concept turnaround in
# apps/vr/ArtSource/lamp-agent/options/ (H-s41 is the target-referenced view the proportions follow).
#   blender -b --factory-startup -P scripts/art/lamp/build_agent.bpy -- <repo> <work>
# Parts, one rigid part per bone (the cable alone is blended between two):
#   body         the tapered cone shell (smooth, a rolled top lip round a dark dished mouth), its amber front slit and dot,
#                the pin under the tip, a short dark neck collar, the shoulder brackets
#   head         the hood (one closed lathe: white outside with a seam ring, a rolled half-round lip, a warm satin inside),
#                the lens (a slightly convex emissive disc set deep in the hood, seated in a stepped reflector cone), the
#                neck stub into the hood's back, the glow card (the lens's hotspot, edge ring and soft falloff)
#   arm_?_upper  shoulder axle drum (caps, screw head) + upper capsule with collar rings;   arm_?_lower  elbow drum +
#                forearm capsule + wrist drum + teardrop wire loop;   cable  body -> arm_r_upper, skinned along its length
# Slots (5, so the static mesh is 5 draws): agent_shell (white clear-coat plastic, roughness breakup), agent_hood_inner (the
# inside of the hood and the reflector: a warm white satin the lens lights), agent_joint (dark metal: drums, caps, screws,
# rings, cable, the body's dished mouth), agent_glow (amber emissive: lens, slit, dot, pin; UE drives its strength),
# agent_glow_card (the additive card over the lens; textures/agent_glow_card.png). Axes: Blender Z up, the figure faces -Y; pivot = the pin tip (z = 0), x/y centred
# on the body axis. Writes into ArtSource/lamp-agent: final.fbx (rig + 4 actions), final_working.glb (static, working pose),
# textures/*.png (AO, roughness and metal baked with Cycles on the CPU); and <work>/build.json, <work>/agent.blend.
import bmesh
import bpy
import json
import math
import os
import sys
from mathutils import Matrix, Vector

argv = sys.argv[sys.argv.index('--') + 1:]
REPO, WORK = argv[0], argv[1]
OUT = os.path.join(REPO, 'apps', 'vr', 'ArtSource', 'lamp-agent')
TEX = os.path.join(OUT, 'textures')
os.makedirs(TEX, exist_ok=True)
os.makedirs(WORK, exist_ok=True)
POSES = json.load(open(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'agent_poses.json')))
BAKE_PX = 2048
R = {}

bpy.ops.wm.read_factory_settings(use_empty=True)
scene = bpy.context.scene
scene.unit_settings.scale_length = 1.0

# ---- dimensions (metres) -------------------------------------------------------------------------------------------
# Proportions (re-measured 2026-10-25 on reference/target-crop.png, in units of the hood's outer width H = 100 px there):
# orb 0.50 H (0.56 of the mouth's inner edge), body below the hood lip 0.66 H, its width 0.62 H at the top and 0.41 H
# three quarters down to a flattened round tip, pin 0.13 H; each elbow sits beside the hood's bottom at 0.46 H off the
# axis, a short upper link from the shoulder, a long forearm (0.97 H elbow to wrist) and a narrow teardrop loop 0.43 H long
# hanging a little nearer vertical than the forearm. The forearm is a full spindle, not a thin taper (FJ, measured across
# both concept arms with scratchpad fid/fj/thick.py): 0.13 H thick near the elbow, 0.16 H in the middle, 0.13 H near the wrist.
PIN = (0.0, 0.020, 0.0009)                  # z from, z to, radius (the concept's pin is a hair-thin rod)
SEAM_D, SEAM_W = 0.0006, 0.0004             # panel seams: a groove this deep, its walls this far either side of it (the hood's ring)
BODY_Z = (0.018, 0.031, 0.114)              # tip, top of the rounded tip cap, top of the cone
BODY_RR = (0.0250, 0.0452)                  # cone radius at the cap and at the top (the tip cap is a flattened half-round)
BODY_DISH = 0.0045                          # the body's open mouth: a dark dish this far below the cone's top

def body_r(z):
    """The cone's radius at z: straight between BODY_RR (the concept's sides do not swell, and it is one smooth sleek shell,
    so no seams), 0.3 mm of fullness."""
    u = (z - BODY_Z[1]) / (BODY_Z[2] - BODY_Z[1])
    return BODY_RR[0] + u * (BODY_RR[1] - BODY_RR[0]) + 0.0003 * math.sin(math.pi * u)

def body_profile():
    """(r, z): the flattened round tip, a straight smooth cone, a thin rolled lip, then down into the dark dished mouth."""
    zt, zc, z1 = BODY_Z
    p = [(0.0, zt)] + [(BODY_RR[0] * math.sin(a), zt + (zc - zt) * (1 - math.cos(a)))
                       for a in (math.pi / 2 * i / 6 for i in range(1, 7))]
    p += [(body_r(z), z) for z in (zc + (z1 - zc) * i / 12 for i in range(1, 13))]
    r1 = body_r(z1)
    p += [(r1 + 0.0005, z1 + 0.0022), (r1 + 0.0002, z1 + 0.0038), (r1 - 0.0009, z1 + 0.0046), (r1 - 0.0021, z1 + 0.0040),
          (r1 - 0.0030, z1 + 0.0010), (r1 - 0.0060, z1 - BODY_DISH + 0.0012), (0.020, z1 - BODY_DISH), (0.0, z1 - BODY_DISH)]
    return p

BODY = body_profile()                       # lathe profile (r, z), tip to the dish centre
BODY_MOUTH_R = BODY_RR[1] - 0.0021          # inside this radius the body's top is its dark mouth (agent_joint)
COLLAR = (0.1175, 0.1365, 0.019)            # the old collar's z from, z to, radius: it still places the head bone's head
NECK = (BODY_Z[2] - BODY_DISH - 0.0005, 0.1120, 0.0095, 0.030)   # the low dark neck boss in the dish: z from, z to, radius, and y (behind the axis, under the hood's whole back)
HEAD_C = Vector((0.0, -0.010, 0.1665))      # hood sphere centre
HOOD_R, HOOD_T, HOOD_CUT = 0.068, 0.0030, 0.18   # outer radius, wall, cut plane at +0.18 R along the opening axis
OPEN_TILT = -40.0                            # the opening looks forward (-Y) and this many degrees up (negative: down; the concept's mouth is 45 degrees off a view from 5 degrees above)
# The lens (2026-10-25): the concept's head is a deep hood holding a recessed glowing disc, not a bulb. A slightly convex
# emissive disc set back in the hood, its axis turned LENS_TILT degrees up from the opening's (so the face reads round, as
# the concept's does, from a view about 45 degrees off the mouth), seated in a stepped reflector cone that closes the
# cavity behind it. ORB_R keeps its name for the glowing face's radius (UE and the manifest still call it the orb).
ORB_R = 0.0365                               # the lens face's radius
LENS_IN, LENS_DROP = -0.017, 0.0115          # its face centre: this far along the opening axis from HEAD_C (negative: recessed), and this far towards the mouth's bottom
LENS_CROWN, LENS_TILT = 0.0035, 14.0         # how far the face domes out at its centre; its axis's tilt up from the opening axis
LIGHT_AHEAD = 0.045                          # the warm light (UE): this far in front of the lens face along the opening axis, just out of the mouth
SHOULDER = Vector((0.051, 0.0, 0.118))       # +X side; mirrored for the right arm
UPPER_L, LOWER_L = 0.017, 0.121             # capsule lengths: a short link out of the shoulder, a long forearm
BALL = (0.0098, 0.0072, 0.0055)              # shoulder, elbow, wrist ball radius
LOWER_R = (0.0088, 0.0082, 0.0024)           # forearm radius at the elbow end, at the wrist end, and its swell between
UPPER_R = (0.0100, 0.0068)                   # the upper link's radius in the middle and at its ends
ELBOW_HUB_R = 0.0090                         # the elbow drum: as wide as the forearm's end, so the joint does not pinch
LOOP = (0.0135, 0.0010)                      # wire loop major / minor radius
LOOP_STRETCH = 2.1                           # the loop's length over its width before the teardrop pinch
LOOP_WIDTH = (0.55, 0.30)                    # its width factor at the far end, and how much it pinches towards the wrist
LOOP_DROOP = 14.0                            # degrees the loop hangs nearer vertical than the forearm
REST_DEG = POSES['rest_arm_deg_from_vertical']
OPEN_AXIS = Vector((0.0, -math.cos(math.radians(OPEN_TILT)), math.sin(math.radians(OPEN_TILT))))
OPEN_DOWN = Vector((0.0, -math.sin(math.radians(OPEN_TILT)), -math.cos(math.radians(OPEN_TILT))))   # across the mouth, to its bottom
LENS_AXIS = Vector((0.0, -math.cos(math.radians(OPEN_TILT + LENS_TILT)), math.sin(math.radians(OPEN_TILT + LENS_TILT))))

# ---- materials -------------------------------------------------------------------------------------------------------
def principled(name, color, rough, metal=0.0, coat=0.0, coat_rough=0.05, emit=None, emit_strength=0.0):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    b = m.node_tree.nodes['Principled BSDF']
    b.inputs['Base Color'].default_value = (*color, 1.0)
    b.inputs['Roughness'].default_value = rough
    b.inputs['Metallic'].default_value = metal
    b.inputs['Coat Weight'].default_value = coat
    b.inputs['Coat Roughness'].default_value = coat_rough
    if emit:
        b.inputs['Emission Color'].default_value = (*emit, 1.0)
        b.inputs['Emission Strength'].default_value = emit_strength
    return m

def srgb(h):
    c = [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    return tuple(x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4 for x in c)

MATS = {
    # r4: white plastic at base albedo about 0.8, roughness 0.35, a second specular lobe (UE: clear coat)
    'agent_shell': dict(color=(0.80, 0.79, 0.77), rough=0.35, coat=1.0, coat_rough=0.08),
    'agent_joint': dict(color=srgb('#3A3D42'), rough=0.38, metal=1.0),
    # the lens is light, not paint: a dark warm base, so the warm light in front of it does not wash it out to a lit cream
    'agent_glow': dict(color=(0.03, 0.018, 0.008), rough=0.3, emit=srgb('#FFA94D'), emit_strength=3.0),
    # the hood's inside and the lens's reflector: in the concept the inside is the same white plastic lit warm by the lens (a
    # cream-to-orange bowl darkening towards the back), so a warm tan satin that the warm light turns orange, well under the
    # shell's albedo so the lens stays the brightest thing; plus a faint warm self-glow for the bounce (UE: GlowStrength x 0.15)
    'agent_hood_inner': dict(color=(0.26, 0.18, 0.11), rough=0.32, coat=0.5, coat_rough=0.12, emit=srgb('#FFC48A'), emit_strength=0.0),
    'agent_glow_card': dict(color=(0, 0, 0), rough=1.0, emit=srgb('#FFB547'), emit_strength=1.0),
}
# Roughness breakup (baked into ORM.G): a smudge noise moves each surface's roughness by this much either way, and the
# shell's albedo by 2 %, so a highlight wanders across the plastic instead of sitting on it like a decal.
BREAKUP = {'agent_shell': (0.07, 0.02), 'agent_hood_inner': (0.08, 0.0), 'agent_joint': (0.1, 0.03)}
mat = {k: principled(k, **v) for k, v in MATS.items()}

def breakup(m, d_rough, d_albedo):
    nt = m.node_tree
    b = nt.nodes['Principled BSDF']
    tc = nt.nodes.new('ShaderNodeTexCoord')
    nz = nt.nodes.new('ShaderNodeTexNoise')
    nz.inputs['Scale'].default_value = 38.0          # object space, metres: blotches of about 1 to 3 cm on a 25 cm figure
    nz.inputs['Detail'].default_value = 6.0
    nz.inputs['Roughness'].default_value = 0.6
    nt.links.new(tc.outputs['Object'], nz.inputs['Vector'])
    r0 = b.inputs['Roughness'].default_value
    mr = nt.nodes.new('ShaderNodeMapRange')
    mr.inputs['From Min'].default_value, mr.inputs['From Max'].default_value = 0.3, 0.7
    mr.inputs['To Min'].default_value, mr.inputs['To Max'].default_value = r0 - d_rough, r0 + d_rough
    nt.links.new(nz.outputs['Fac'], mr.inputs['Value'])
    nt.links.new(mr.outputs['Result'], b.inputs['Roughness'])
    if d_albedo:
        c = b.inputs['Base Color'].default_value
        mc = nt.nodes.new('ShaderNodeMapRange')
        mc.inputs['From Min'].default_value, mc.inputs['From Max'].default_value = 0.3, 0.7
        mc.inputs['To Min'].default_value, mc.inputs['To Max'].default_value = 1 - d_albedo, 1 + d_albedo
        nt.links.new(nz.outputs['Fac'], mc.inputs['Value'])
        mul = nt.nodes.new('ShaderNodeVectorMath'); mul.operation = 'SCALE'
        mul.inputs[0].default_value = (c[0], c[1], c[2])
        nt.links.new(mc.outputs['Result'], mul.inputs['Scale'])
        nt.links.new(mul.outputs['Vector'], b.inputs['Base Color'])

for k, (dr, da) in BREAKUP.items():
    breakup(mat[k], dr, da)
R['materials'] = {k: {kk: (list(vv) if isinstance(vv, tuple) else vv) for kk, vv in v.items()} for k, v in MATS.items()}
R['seams'] = f'{SEAM_D * 1000:.1f} mm deep, {2 * SEAM_W * 1000:.1f} mm wide grooves'
R['breakup'] = {k: {'roughness_pm': v[0], 'albedo_pm': v[1]} for k, v in BREAKUP.items()}

# ---- part builders ----------------------------------------------------------------------------------------------------
parts = []   # (object, bone)

def finish(ob, slot, bone, smooth=True):
    ob.data.materials.append(mat[slot])
    if smooth:
        for p in ob.data.polygons:
            p.use_smooth = True
    parts.append((ob, bone))
    return ob

def new_obj(name, bm):
    me = bpy.data.meshes.new(name)
    bm.to_mesh(me)
    bm.free()
    ob = bpy.data.objects.new(name, me)
    scene.collection.objects.link(ob)
    return ob

def seam_angles(segs, seams_deg):
    """segs even angles, with each seam angle and a wall either side of it (SEAM_W of arc at r = 4 cm) put in."""
    d = math.degrees(SEAM_W / 0.04)
    angs = [360.0 * i / segs for i in range(segs)]
    angs = [a for a in angs if all(min(abs(a - s), 360 - abs(a - s)) > 1.5 * d for s in seams_deg)]
    angs += [s + k * d for s in seams_deg for k in (-1, 0, 1)]
    return sorted(a % 360 for a in angs)

def lathe(name, profile, segs, axis_from=Vector((0, 0, 0)), axis_dir=Vector((0, 0, 1)), seams_deg=()):
    """A surface of revolution: profile (r, t) or (r, t, seamable) along axis_dir from axis_from; r = 0 ends close to a
    pole. With seams_deg, the seamable rings dip SEAM_D at those angles: a vertical panel seam."""
    bm = bmesh.new()
    q = Vector((0, 0, 1)).rotation_difference(axis_dir.normalized()).to_matrix()
    angs = seam_angles(segs, seams_deg) if seams_deg else [360.0 * i / segs for i in range(segs)]
    segs = len(angs)
    rings = []
    for r, t, *flag in profile:
        if r < 1e-6:
            rings.append([bm.verts.new(axis_from + q @ Vector((0, 0, t)))])
        else:
            def rr(a):
                return r - SEAM_D if flag and flag[0] and any(abs(a - s) < 1e-6 for s in seams_deg) else r
            rings.append([bm.verts.new(axis_from + q @ Vector((rr(a) * math.cos(math.radians(a)), rr(a) * math.sin(math.radians(a)), t)))
                          for a in angs])
    for a, b in zip(rings, rings[1:]):
        if len(a) == 1:
            for i in range(segs):
                bm.faces.new((a[0], b[(i + 1) % segs], b[i]))
        elif len(b) == 1:
            for i in range(segs):
                bm.faces.new((a[i], a[(i + 1) % segs], b[0]))
        else:
            for i in range(segs):
                bm.faces.new((a[i], a[(i + 1) % segs], b[(i + 1) % segs], b[i]))
    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
    return new_obj(name, bm)

def capsule(name, start, end, r_mid, r_end, segs=14, rings=7):
    """A spindle: rounded ends, widest in the middle (the arm segments of the concept)."""
    d = end - start
    L = d.length
    prof = [(0.0, 0.0)]
    for i in range(1, rings + 1):            # end cap, a quarter ellipse up to r_end
        a = math.pi / 2 * i / rings
        prof.append((r_end * math.sin(a), r_end * (1 - math.cos(a))))
    for i in range(1, 6):                    # swell to r_mid and back
        t = i / 6
        prof.append((r_end + (r_mid - r_end) * math.sin(math.pi * t), r_end + (L - 2 * r_end) * t))
    for i in range(rings - 1, -1, -1):
        a = math.pi / 2 * i / rings
        prof.append((r_end * math.sin(a), L - r_end * (1 - math.cos(a))))
    prof[-1] = (0.0, L)
    return lathe(name, prof, segs, start, d)

def tapered(name, start, end, r_a, r_b, swell=0.0006, segs=14, rings=6):
    """A long arm segment: a rounded cap of r_a at start, a straight run to a cap of r_b, swelling by `swell` between."""
    d = end - start
    L = d.length
    prof = [(0.0, 0.0)] + [(r_a * math.sin(a), r_a * (1 - math.cos(a))) for a in (math.pi / 2 * i / rings for i in range(1, rings + 1))]
    for i in range(1, 8):
        t = i / 8
        prof.append((r_a + (r_b - r_a) * t + swell * math.sin(math.pi * t), r_a + (L - r_a - r_b) * t))
    prof += [(r_b * math.sin(a), L - r_b * (1 - math.cos(a))) for a in (math.pi / 2 * i / rings for i in range(rings, -1, -1))]
    prof[-1] = (0.0, L)
    return lathe(name, prof, segs, start, d)

def cylinder(name, z0, z1, r, segs, centre=Vector((0, 0, 0))):
    bm = bmesh.new()
    bmesh.ops.create_cone(bm, cap_ends=True, segments=segs, radius1=r, radius2=r, depth=z1 - z0,
                          matrix=Matrix.Translation(centre + Vector((0, 0, (z0 + z1) / 2))))
    return new_obj(name, bm)

def cyl_axis(name, centre, axis, r, length, segs):
    """A capped cylinder of `length` along `axis`, centred on `centre`."""
    bm = bmesh.new()
    bmesh.ops.create_cone(bm, cap_ends=True, segments=segs, radius1=r, radius2=r, depth=length)
    q = Vector((0, 0, 1)).rotation_difference(Vector(axis).normalized()).to_matrix().to_4x4()
    bmesh.ops.transform(bm, matrix=Matrix.Translation(centre) @ q, verts=bm.verts)
    return new_obj(name, bm)

def dome(name, centre, axis, r, h, segs=12):
    """A screw head: a low dome of radius r and height h on a flat base at `centre`, rising along `axis`."""
    prof = [(0.0, -0.0003)] + [(r, -0.0003)] + [(r * math.cos(a), h * math.sin(a)) for a in (math.pi / 2 * i / 4 for i in range(4))] + [(0.0, h)]
    return lathe(name, prof, segs, centre, Vector(axis))

def add_mods(ob, bevel=None, weighted=False):
    if bevel:
        m = ob.modifiers.new('bevel', 'BEVEL')
        m.width, m.segments, m.limit_method, m.angle_limit = bevel, 2, 'ANGLE', math.radians(30)
        m.harden_normals = True
        m.miter_outer = 'MITER_ARC'
    if weighted:
        w = ob.modifiers.new('wn', 'WEIGHTED_NORMAL')
        w.keep_sharp = True
        w.weight = 50

# ---- body ---------------------------------------------------------------------------------------------------------------
body_ob = lathe('body', BODY, 40)
finish(body_ob, 'agent_shell', 'body')
body_ob.data.materials.append(mat['agent_joint'])
for p in body_ob.data.polygons:              # the dished mouth inside the lip is dark, as the concept's open cone top
    if p.center.z < BODY_Z[2] + 0.0035 and p.center.z > BODY_Z[2] - BODY_DISH - 0.001 and math.hypot(p.center.x, p.center.y) < BODY_MOUTH_R - 0.0004 and p.normal.z > 0.2:
        p.material_index = 1
pin = cylinder('pin', PIN[0], PIN[1], PIN[2], 8)
finish(pin, 'agent_glow', 'body')
collar = cylinder('collar', NECK[0], NECK[1], NECK[2], 32, centre=Vector((0, NECK[3], 0)))
add_mods(collar, bevel=0.0012, weighted=True)
finish(collar, 'agent_joint', 'body')
# the slit: a thin proud strip on the body front, following the cone's lean
z_mid = 0.067
lean = math.atan2(body_r(z_mid + 0.01) - body_r(z_mid - 0.01), 0.02)
bm = bmesh.new()
bmesh.ops.create_cube(bm, size=1.0)
bmesh.ops.scale(bm, vec=(0.0030, 0.0016, 0.026), verts=bm.verts)
bmesh.ops.rotate(bm, verts=bm.verts, cent=(0, 0, 0), matrix=Matrix.Rotation(-lean, 3, 'X'))
bmesh.ops.translate(bm, vec=(0, -(body_r(z_mid) - 0.0004), z_mid), verts=bm.verts)
slit = new_obj('slit', bm)
add_mods(slit, bevel=0.0005)
finish(slit, 'agent_glow', 'body')
# the concept's small glowing dot just above the slit
z_dot = 0.086
dot_ = cyl_axis('slit_dot', Vector((0, -(body_r(z_dot) - 0.0002), z_dot)), Vector((0, -1, 0)), 0.0017, 0.0012, 12)
add_mods(dot_, bevel=0.0003)
finish(dot_, 'agent_glow', 'body')

# ---- head: hood shell, orb, glow card -------------------------------------------------------------------------------------
# One closed lathe about the opening axis: the outer sphere from the back pole to the cut (a panel seam ring part way),
# a rolled half-round lip (the crisp bright rim of the concept), and the inner wall back to the inner pole.
HOOD_SEAM_PHI = -38.0                       # the outer seam ring, degrees of latitude (the cut is near +10)
phi_cut = math.degrees(math.asin(HOOD_CUT))
hp = []
for k in range(17):                          # outer, back pole to the cut
    ph = -90.0 + (phi_cut + 90.0) * k / 16
    hp.append((HOOD_R, ph))
dph = math.degrees(SEAM_W / HOOD_R)
hp = [p for p in hp if abs(p[1] - HOOD_SEAM_PHI) > 1.5 * dph] + [(HOOD_R, HOOD_SEAM_PHI - dph), (HOOD_R - SEAM_D, HOOD_SEAM_PHI), (HOOD_R, HOOD_SEAM_PHI + dph)]
hp.sort(key=lambda p: p[1])
prof = [(rad * math.cos(math.radians(ph)), rad * math.sin(math.radians(ph))) for rad, ph in hp]
prof[0] = (0.0, -HOOD_R)
z_cut = HOOD_R * math.sin(math.radians(phi_cut))
r_mid = (HOOD_R - HOOD_T / 2) * math.cos(math.radians(phi_cut))
for k in range(1, 8):                        # the lip: a half-round over the wall's top, outside to inside
    th = math.pi * k / 8
    prof.append((r_mid + HOOD_T / 2 * math.cos(th), z_cut + HOOD_T / 2 * 1.1 * math.sin(th)))
RI = HOOD_R - HOOD_T
for k in range(16, -1, -1):                  # inner wall, the cut back to the inner pole
    ph = -90.0 + (phi_cut + 90.0) * k / 16
    prof.append((RI * math.cos(math.radians(ph)), RI * math.sin(math.radians(ph))))
prof[-1] = (0.0, -RI)
hood = lathe('hood', prof, 40, HEAD_C, OPEN_AXIS)
finish(hood, 'agent_shell', 'head')
hood.data.materials.append(mat['agent_hood_inner'])
for p in hood.data.polygons:
    if (p.center - HEAD_C).dot(p.normal) < 0:
        p.material_index = 1
# the lens: one closed lathe about LENS_AXIS from its face centre. Front to back: the convex face (agent_glow) to its rim,
# the reflector (agent_hood_inner) flaring forward in two shallow steps to just inside the hood's inner wall, its back
# face, and the lens's back to the axis. The reflector closes the cavity behind the lens, so nothing behind it (the neck
# stub, the hood's back) shows through the mouth but the lit bowl.
orb_c = HEAD_C + OPEN_AXIS * LENS_IN + OPEN_DOWN * LENS_DROP
lp = [(ORB_R * math.sin(math.pi / 2 * k / 6), LENS_CROWN * math.cos(math.pi / 2 * k / 6)) for k in range(7)]
lp[0] = (0.0, LENS_CROWN)
# the reflector's outer edge: as wide as fits 1.2 mm inside the hood's inner wall all the way round (the lens sits below
# the opening axis, so the bottom of the ring is what limits it)
REFL_T = 0.0098                              # how far forward of the lens face the reflector meets the wall
def refl_fits(r_out):
    for k in range(72):
        a = 2 * math.pi * k / 72
        perp = Vector((math.cos(a), 0, 0)) + LENS_AXIS.cross(Vector((1, 0, 0))).normalized() * math.sin(a)
        if (orb_c + LENS_AXIS * REFL_T + perp * r_out - HEAD_C).length > HOOD_R - HOOD_T - 0.0012:
            return False
    return True
REFL_R = max(r for r in (ORB_R + 0.010 + 0.0005 * i for i in range(60)) if refl_fits(r))
def refl(u, t):                              # u: 0 at the lens rim, 1 at the outer edge
    return (ORB_R + 0.0024 + u * (REFL_R - ORB_R - 0.0024), t)
lp += [(ORB_R + 0.0010, 0.0009), (ORB_R + 0.0020, -0.0003)]                    # the face's rim: a raised 2 mm emissive bead, the concept's bright edge ring
lp += [refl(0.0, -0.0022), refl(0.32, 0.0010), refl(0.38, 0.0002), refl(0.72, 0.0058),
       refl(0.78, 0.0050), refl(1.0, REFL_T)]                                 # (r, t): the reflector, two steps out to the wall
lp += [refl(1.0, REFL_T - 0.0022), refl(0.2, -0.0040), (ORB_R - 0.002, -0.0070), (0.0, -0.0075)]
lens = lathe('orb', lp, 48, orb_c, LENS_AXIS)
# the reflector's outer edge (its last two rings) pushed out across the axis to 1.2 mm inside the hood's wall all the way
# round: the lens sits below the opening axis, so a round edge would leave a dark crescent of open cavity at the top and sides
wall = HOOD_R - HOOD_T - 0.0012
for v in lens.data.vertices:
    rel = v.co - orb_c
    t = rel.dot(LENS_AXIS)
    rad = rel - LENS_AXIS * t
    if abs(rad.length - REFL_R) < 1e-5:
        u = rad.normalized()
        base = orb_c + LENS_AXIS * t - HEAD_C        # |base + u x| = wall, for x > 0
        b = base.dot(u); c = base.length_squared - wall * wall
        v.co = orb_c + LENS_AXIS * t + u * (-b + math.sqrt(b * b - c))
finish(lens, 'agent_glow', 'head')
lens.data.materials.append(mat['agent_hood_inner'])
for p in lens.data.polygons:                 # the face is emissive; the reflector and the back are the hood's inside
    rel = p.center - orb_c
    t = rel.dot(LENS_AXIS)
    if t < -0.0012 or (rel - LENS_AXIS * t).length > ORB_R + 0.0021:
        p.material_index = 1
R['lens'] = {'radius_m': ORB_R, 'reflector_r_m': round(REFL_R, 4), 'face_behind_cut_m': round(HOOD_R * HOOD_CUT - (orb_c - HEAD_C).dot(OPEN_AXIS), 4),
             'crown_m': LENS_CROWN, 'tilt_deg': LENS_TILT}
# the neck stub: from the boss up and back into the hood's underside (where the shell is whole), so the head is carried
# from behind the mouth and nothing stands under the lens (the old collar, seen through the mouth, read as a bulb's socket)
neck_a = Vector((0.0, NECK[3] + 0.002, NECK[1] - 0.003))
neck_b = HEAD_C + Vector((0.0, math.sin(math.radians(40)), -math.cos(math.radians(40)))) * (HOOD_R - HOOD_T * 0.5)
stub = cyl_axis('neck_stub', (neck_a + neck_b) / 2, neck_b - neck_a, 0.0075, (neck_b - neck_a).length, 24)
add_mods(stub, bevel=0.0008, weighted=True)
finish(stub, 'agent_joint', 'head')

# ---- arms --------------------------------------------------------------------------------------------------------------
def arm(side):
    sx = 1 if side == 'l' else -1
    sh = Vector((SHOULDER.x * sx, SHOULDER.y, SHOULDER.z))
    d = Vector((sx * math.sin(math.radians(REST_DEG)), 0, -math.cos(math.radians(REST_DEG))))
    elbow = sh + d * (BALL[0] + UPPER_L + BALL[1] * 0.6)
    wrist = elbow + d * (BALL[1] * 0.6 + LOWER_L + BALL[2] * 0.6)
    up, lo = f'arm_{side}_upper', f'arm_{side}_lower'
    hinge = Vector((0, -1, 0))                 # the arms swing in the XZ plane: every hinge axle points at the viewer
    def hub(tag, c, r, length, bone, screw=True):
        """Joint hardware: a bevelled axle drum, a proud cap on its front face and a domed screw head on the cap."""
        h = cyl_axis(f'{tag}_hub_{side}', c, hinge, r, length, 16); add_mods(h, bevel=r * 0.12, weighted=True); finish(h, 'agent_joint', bone)
        cp = cyl_axis(f'{tag}_cap_{side}', c + hinge * (length / 2 + 0.0004), hinge, r * 0.72, 0.0012, 14)   # front only: the back never faces the player
        add_mods(cp, bevel=0.0003, weighted=True); finish(cp, 'agent_joint', bone)
        if screw:
            finish(dome(f'{tag}_screw_{side}', c + hinge * (length / 2 + 0.001), hinge, r * 0.32, r * 0.16), 'agent_joint', bone)
    # the shoulder: a bracket plate on the body side carries the axle (the bracket is the body's, the drum the arm's)
    br = cyl_axis(f'shoulder_bracket_{side}', sh - Vector((sx * 0.006, 0, 0.0)), Vector((1, 0, 0)), 0.0068, 0.012, 16)
    add_mods(br, bevel=0.0008, weighted=True); finish(br, 'agent_joint', 'body')
    hub('shoulder', sh, BALL[0] * 0.95, 0.016, up)
    upper_a, upper_b = sh + d * (BALL[0] * 0.55), elbow - d * (BALL[1] * 0.45)
    finish(capsule(f'upper_{side}', upper_a, upper_b, *UPPER_R), 'agent_shell', up)
    # a dark collar ring at each end of each arm segment, where the shell meets the joint
    def collar_ring(tag, at, axis, r, bone):
        c = cyl_axis(f'{tag}_{side}', at, axis, r, 0.0028, 16); add_mods(c, bevel=0.0004, weighted=True); finish(c, 'agent_joint', bone)
    if (upper_b - upper_a).length > 0.03:     # the short link between two drums has no room for rings
        collar_ring('upper_ring_a', upper_a + d * 0.0085, d, 0.0067, up)
        collar_ring('upper_ring_b', upper_b - d * 0.0080, d, 0.0066, up)
    hub('elbow', elbow, ELBOW_HUB_R, 0.012, lo)
    lower_a, lower_b = elbow + d * (BALL[1] * 0.45), wrist - d * (BALL[2] * 0.4)
    finish(tapered(f'lower_{side}', lower_a, lower_b, *LOWER_R), 'agent_shell', lo)
    collar_ring('lower_ring_a', lower_a + d * 0.0063, d, LOWER_R[0] * 1.04, lo)
    collar_ring('lower_ring_b', lower_b - d * 0.0050, d, LOWER_R[1] * 1.05, lo)
    hub('wrist', wrist, BALL[2], 0.009, lo, screw=False)
    bm = bmesh.new()
    # a torus in the arm's plane (XZ), its near edge at the wrist ball
    for i in range(24):
        a = 2 * math.pi * i / 24
        c = Vector((LOOP[0] * math.cos(a), 0, LOOP[0] * math.sin(a)))
        n = c.normalized()
        for j in range(6):
            b2 = 2 * math.pi * j / 6
            bm.verts.new(c + n * LOOP[1] * math.cos(b2) + Vector((0, LOOP[1] * math.sin(b2), 0)))
    bm.verts.ensure_lookup_table()
    for i in range(24):
        for j in range(6):
            a0, a1 = i * 6 + j, i * 6 + (j + 1) % 6
            b0, b1 = ((i + 1) % 24) * 6 + j, ((i + 1) % 24) * 6 + (j + 1) % 6
            bm.faces.new((bm.verts[a0], bm.verts[b0], bm.verts[b1], bm.verts[a1]))
    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
    # the concept's wire loop is a long narrow teardrop: stretched along the arm, pinched towards the wrist
    for v in bm.verts:
        t = (v.co.z / LOOP[0] + 1) / 2            # 0 at the far end, 1 at the wrist end
        v.co.x *= LOOP_WIDTH[0] - LOOP_WIDTH[1] * t
    bmesh.ops.scale(bm, vec=(1.0, 1.0, LOOP_STRETCH), verts=bm.verts)
    dl = Matrix.Rotation(math.radians(LOOP_DROOP * sx), 3, 'Y') @ d      # it hangs a little nearer vertical than the forearm
    rot = Vector((0, 0, -1)).rotation_difference(dl).to_matrix().to_4x4()
    bmesh.ops.transform(bm, matrix=Matrix.Translation(wrist + dl * (BALL[2] + LOOP[0] * LOOP_STRETCH - 0.0014)) @ rot @ Matrix.Translation((0, 0, 0)), verts=bm.verts)
    finish(new_obj(f'loop_{side}', bm), 'agent_shell', lo)       # a bright wire, as the concept's
    return sh, elbow, wrist

joints = {s: arm(s) for s in ('l', 'r')}

# ---- the soft cable: out of the body's back, sagging, into the back of the hanging (right) upper arm --------------------
# Skinned, not rigid: its weights run from the body to arm_r_upper along its length (smoothstep), so a pose bends it
# instead of tearing it; the only vertices of the figure with two influences.
CABLE_R = 0.0011
sh_r, el_r, _ = joints['r']
d_r = (el_r - sh_r).normalized()
p0 = Vector((-0.024, 0.026, 0.096))                                    # the body's back, left of the spine (viewer's view)
p3 = sh_r + d_r * 0.014 + Vector((0, 0.0075, 0))                       # the back of the short upper link
c1, c2 = p0 + Vector((-0.004, 0.016, -0.026)), p3 + Vector((0.006, 0.014, -0.022))
N_C, S_C = 20, 8
bm = bmesh.new()
rings, ts = [], []
for i in range(N_C + 1):
    t = i / N_C
    p = (1 - t) ** 3 * p0 + 3 * (1 - t) ** 2 * t * c1 + 3 * (1 - t) * t ** 2 * c2 + t ** 3 * p3
    tg = (3 * (1 - t) ** 2 * (c1 - p0) + 6 * (1 - t) * t * (c2 - c1) + 3 * t ** 2 * (p3 - c2)).normalized()
    u = Vector((0, 0, 1)); u = (u - tg * u.dot(tg)).normalized(); w = tg.cross(u)
    rings.append([bm.verts.new(p + (u * math.cos(2 * math.pi * k / S_C) + w * math.sin(2 * math.pi * k / S_C)) * CABLE_R) for k in range(S_C)])
    ts += [t] * S_C
for a, b in zip(rings, rings[1:]):
    for k in range(S_C):
        bm.faces.new((a[k], a[(k + 1) % S_C], b[(k + 1) % S_C], b[k]))
for rg in (rings[0], rings[-1]):
    bm.faces.new(rg)
bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
cable = new_obj('cable', bm)
CABLE_W = [3 * t * t - 2 * t ** 3 for t in ts]                        # weight to arm_r_upper; body gets 1 - w
finish(cable, 'agent_joint', None)
R['cable'] = {'verts': len(cable.data.vertices), 'radius_m': CABLE_R, 'from_bone': 'body', 'to_bone': 'arm_r_upper'}

# ---- apply modifiers, join into one mesh with one vertex group per bone (weight 1.0) ------------------------------------
bones = ['body', 'head', 'arm_l_upper', 'arm_l_lower', 'arm_r_upper', 'arm_r_lower']
for ob, bone in parts:
    for o in bpy.context.selected_objects:
        o.select_set(False)
    ob.select_set(True)
    bpy.context.view_layer.objects.active = ob
    for m in list(ob.modifiers):
        bpy.ops.object.modifier_apply(modifier=m.name)
    if bone is None:                         # the cable: blended body -> arm_r_upper
        vb, va = ob.vertex_groups.new(name='body'), ob.vertex_groups.new(name='arm_r_upper')
        for i, w in enumerate(CABLE_W):
            if w < 1.0:
                vb.add([i], 1.0 - w, 'REPLACE')
            if w > 0.0:
                va.add([i], w, 'REPLACE')
        continue
    vg = ob.vertex_groups.new(name=bone)
    vg.add(range(len(ob.data.vertices)), 1.0, 'REPLACE')
part_tris = {}
for ob, bone in parts:
    part_tris[ob.name] = sum(len(p.vertices) - 2 for p in ob.data.polygons)
R['part_tris'] = part_tris
for o in bpy.context.selected_objects:
    o.select_set(False)
for ob, _ in parts:
    ob.select_set(True)
body = parts[0][0]
bpy.context.view_layer.objects.active = body
bpy.ops.object.join()
agent = body
agent.name = agent.data.name = 'lamp-agent'
# the figure's own height: body and head parts only (in the rest pose the hanging arms reach below the pin tip)
core = {agent.vertex_groups[n].index for n in ('body', 'head')}
zs = [v.co.z for v in agent.data.vertices if any(g.group in core for g in v.groups)]
R['rest'] = {'height_m': round(max(zs) - min(zs), 4), 'min_z_m': round(min(zs), 4), 'hood_width_m': round(2 * HOOD_R, 4),
             'body_top_width_m': round(2 * max(p[0] for p in BODY), 4)}

# ---- one UV set, packed; the card is added after the bakes with its own 0-1 UVs ---------------------------------------
bpy.ops.object.mode_set(mode='EDIT')
bpy.ops.mesh.select_all(action='SELECT')
bpy.ops.uv.smart_project(angle_limit=math.radians(55), island_margin=0.004, area_weight=0.0, scale_to_bounds=True)
bpy.ops.object.mode_set(mode='OBJECT')
agent.data.uv_layers[0].name = 'UVMap'

# ---- bakes on the CPU: AO, roughness, metal (emit trick), base colour (diffuse colour) ----------------------------------
scene.render.engine = 'CYCLES'
scene.cycles.device = 'CPU'
scene.cycles.samples = 64
scene.render.bake.margin = 6
# a floor-less, world-less scene: AO sees only the agent itself (contact between hood, collar, body and the arm joints)
scene.world = bpy.data.worlds.new('bake') if scene.world is None else scene.world
scene.world.use_nodes = True
scene.world.node_tree.nodes['Background'].inputs['Color'].default_value = (1, 1, 1, 1)

def bake_into(name, btype, colorspace='Non-Color', **kw):
    img = bpy.data.images.new(name, BAKE_PX, BAKE_PX, alpha=False, float_buffer=False)
    img.colorspace_settings.name = colorspace
    for m in agent.data.materials:
        nt = m.node_tree
        n = nt.nodes.get('bake') or nt.nodes.new('ShaderNodeTexImage')
        n.name = 'bake'
        n.image = img
        nt.nodes.active = n
    bpy.ops.object.select_all(action='DESELECT')
    agent.select_set(True)
    bpy.context.view_layer.objects.active = agent
    bpy.ops.object.bake(type=btype, use_clear=True, margin=6, **kw)
    return img

import time
t0 = time.time()
ao = bake_into('agent_ao', 'AO')
rough = bake_into('agent_roughness', 'ROUGHNESS')
saved = {}
for m in agent.data.materials:            # metal as emission, read back by an EMIT bake
    b = m.node_tree.nodes['Principled BSDF']
    saved[m.name] = (tuple(b.inputs['Emission Color'].default_value), b.inputs['Emission Strength'].default_value)
    v = b.inputs['Metallic'].default_value
    b.inputs['Emission Color'].default_value = (v, v, v, 1)
    b.inputs['Emission Strength'].default_value = 1.0
metal = bake_into('agent_metal', 'EMIT')
for m in agent.data.materials:
    b = m.node_tree.nodes['Principled BSDF']
    b.inputs['Emission Color'].default_value, b.inputs['Emission Strength'].default_value = saved[m.name][0], saved[m.name][1]
base = bake_into('agent_basecolor', 'DIFFUSE', colorspace='sRGB', pass_filter={'COLOR'})
R['bake_seconds'] = round(time.time() - t0, 1)

def pixels(img):
    import array
    a = array.array('f', [0.0]) * (img.size[0] * img.size[1] * 4)
    img.pixels.foreach_get(a)
    return a

def save(img, fname):
    img.filepath_raw = os.path.join(TEX, fname)
    img.file_format = 'PNG'
    img.save()

# ORM: R occlusion, G roughness, B metal
orm = bpy.data.images.new('agent_orm', BAKE_PX, BAKE_PX, alpha=False)
orm.colorspace_settings.name = 'Non-Color'
pa, pr, pm = pixels(ao), pixels(rough), pixels(metal)
po = pa[:]
for i in range(0, len(po), 4):
    po[i + 1], po[i + 2], po[i + 3] = pr[i], pm[i], 1.0
orm.pixels.foreach_set(po)
save(orm, 'agent_orm.png')
save(base, 'agent_basecolor.png')
ao_vals = [pa[i] for i in range(0, len(pa), 4)]
R['ao'] = {'min': round(min(ao_vals), 3), 'mean': round(sum(ao_vals) / len(ao_vals), 3), 'px': BAKE_PX, 'samples': scene.cycles.samples}

# glow card texture, white on black (UE: additive, tinted by the glow colour), d in units of the card's half width: the
# concept's lens is a soft hotspot in the middle, a thin bright ring at its edge, and a soft falloff past the edge onto
# the reflector
CARD_PX = 256
CARD_HALF = 0.058                            # the card's half width (m): just inside the hood's inner wall at the lens
RING = ORB_R / CARD_HALF
card_img = bpy.data.images.new('agent_glow_card', CARD_PX, CARD_PX, alpha=False)
cp = [0.0] * (CARD_PX * CARD_PX * 4)
for y in range(CARD_PX):
    for x in range(CARD_PX):
        d = math.hypot((x + 0.5) / CARD_PX - 0.5, (y + 0.5) / CARD_PX - 0.5) * 2
        hot = 0.40 * math.exp(-(d / 0.22) ** 2)
        ring = 1.00 * math.exp(-((d - RING) / 0.032) ** 2)
        tail = 0.12 * (math.exp(-(d - RING) / 0.12) if d > RING else (d / RING) ** 4)
        v = min(1.0, hot + ring + tail) * max(0.0, min(1.0, (1.0 - d) / 0.08))
        i = (y * CARD_PX + x) * 4
        cp[i:i + 4] = [v, v, v, 1.0]
card_img.pixels.foreach_set(cp)
save(card_img, 'agent_glow_card.png')

# ---- the glow card: a quad just in front of the lens face, facing out along the lens axis, as wide as the reflector -------
bm = bmesh.new()
half = CARD_HALF
vs = [bm.verts.new((x, y, 0)) for x, y in ((-half, -half), (half, -half), (half, half), (-half, half))]
f = bm.faces.new(vs)
uv = bm.loops.layers.uv.new('UVMap')
for loop, c in zip(f.loops, ((0, 0), (1, 0), (1, 1), (0, 1))):
    loop[uv].uv = c
card_rot = Vector((0, 0, 1)).rotation_difference(LENS_AXIS).to_matrix().to_4x4()
bmesh.ops.transform(bm, matrix=Matrix.Translation(orb_c + LENS_AXIS * (LENS_CROWN + 0.0025)) @ card_rot, verts=bm.verts)
card = new_obj('card', bm)
card.data.materials.append(mat['agent_glow_card'])
card.vertex_groups.new(name='head').add(range(4), 1.0, 'REPLACE')
bpy.ops.object.select_all(action='DESELECT')
card.select_set(True); agent.select_set(True)
bpy.context.view_layer.objects.active = agent
bpy.ops.object.join()

# the shipped materials: Principled with the baked maps wired in (base colour x AO at 0.6, as UE should do it)
for m in agent.data.materials:
    nt = m.node_tree
    if 'bake' in nt.nodes:
        nt.nodes.remove(nt.nodes['bake'])
    b = nt.nodes['Principled BSDF']
    if m.name in ('agent_shell', 'agent_joint', 'agent_hood_inner'):
        tb = nt.nodes.new('ShaderNodeTexImage'); tb.image = base
        to = nt.nodes.new('ShaderNodeTexImage'); to.image = orm
        sp = nt.nodes.new('ShaderNodeSeparateColor')
        mix = nt.nodes.new('ShaderNodeMix'); mix.data_type = 'RGBA'; mix.blend_type = 'MULTIPLY'
        mix.inputs['Factor'].default_value = 0.6
        nt.links.new(to.outputs['Color'], sp.inputs['Color'])
        nt.links.new(tb.outputs['Color'], mix.inputs['A'])
        nt.links.new(sp.outputs['Red'], mix.inputs['B'])
        nt.links.new(mix.outputs['Result'], b.inputs['Base Color'])
        nt.links.new(sp.outputs['Green'], b.inputs['Roughness'])
        nt.links.new(sp.outputs['Blue'], b.inputs['Metallic'])
    if m.name == 'agent_glow_card':
        tc = nt.nodes.new('ShaderNodeTexImage'); tc.image = card_img
        nt.links.new(tc.outputs['Color'], b.inputs['Alpha'])
        m.blend_method = 'BLEND' if hasattr(m, 'blend_method') else None
        m.surface_render_method = 'BLENDED'

# ---- armature: six bones, rigid -------------------------------------------------------------------------------------------
arm_data = bpy.data.armatures.new('lamp-agent_rig')
rig = bpy.data.objects.new('lamp-agent_rig', arm_data)
scene.collection.objects.link(rig)
bpy.context.view_layer.objects.active = rig
bpy.ops.object.mode_set(mode='EDIT')
eb = arm_data.edit_bones
def bone(name, head, tail, parent=None):
    b = eb.new(name); b.head, b.tail = head, tail
    if parent: b.parent = eb[parent]
    return b
bone('body', Vector((0, 0, 0)), Vector((0, 0, COLLAR[0])))
bone('head', Vector((0, 0, COLLAR[1] - 0.004)), HEAD_C + Vector((0, 0, HOOD_R)), 'body')
for s in ('l', 'r'):
    sh, el, wr = joints[s]
    bone(f'arm_{s}_upper', sh, el, 'body')
    bone(f'arm_{s}_lower', el, wr, f'arm_{s}_upper')
for b in eb:
    b.roll = 0.0
bpy.ops.object.mode_set(mode='OBJECT')
agent.parent = rig
mod = agent.modifiers.new('rig', 'ARMATURE'); mod.object = rig

# ---- poses as actions (two keys each), rotations about the armature axes at each bone head ------------------------------
rig.animation_data_create()
bpy.context.view_layer.objects.active = rig
bpy.ops.object.mode_set(mode='POSE')
pb = rig.pose.bones
def pose_bone(n, deg):
    rr = rig.data.bones[n].matrix_local.to_3x3()
    world = (Matrix.Rotation(math.radians(deg[2]), 3, 'Z') @ Matrix.Rotation(math.radians(deg[1]), 3, 'Y')
             @ Matrix.Rotation(math.radians(deg[0]), 3, 'X'))
    pb[n].rotation_mode = 'QUATERNION'
    pb[n].rotation_quaternion = (rr.inverted() @ world @ rr).to_quaternion()
for name, spec in POSES['poses'].items():
    act = bpy.data.actions.new(name); act.use_fake_user = True
    rig.animation_data.action = act
    for f in (1, 12):
        for n in bones:
            pose_bone(n, spec.get(n, [0, 0, 0]))
            pb[n].keyframe_insert('rotation_quaternion', frame=f)
bpy.ops.object.mode_set(mode='OBJECT')
R['actions'] = list(POSES['poses'])
R['bones'] = bones
R['hierarchy'] = {b.name: (b.parent.name if b.parent else None) for b in rig.data.bones}

# ---- exports ----------------------------------------------------------------------------------------------------------------
rig.animation_data.action = bpy.data.actions[POSES['static_pose']]
scene.frame_set(1)
bpy.ops.object.select_all(action='DESELECT')
agent.select_set(True); rig.select_set(True)
bpy.ops.export_scene.fbx(filepath=os.path.join(OUT, 'final.fbx'), use_selection=True, object_types={'ARMATURE', 'MESH'},
                         add_leaf_bones=False, bake_anim=True, bake_anim_use_all_actions=True, bake_anim_use_nla_strips=False,
                         bake_anim_simplify_factor=0.0, path_mode='STRIP', embed_textures=False, use_armature_deform_only=True)
# the static working pose: a copy with the armature applied, no rig (4 slots = 4 draws, no skinning)
st = agent.copy(); st.data = agent.data.copy(); scene.collection.objects.link(st)
agent.name = 'lamp-agent_skinned'
st.name = st.data.name = 'lamp-agent'
bpy.ops.object.select_all(action='DESELECT')
st.select_set(True); bpy.context.view_layer.objects.active = st
st.parent = None
bpy.ops.object.modifier_apply(modifier='rig')
st.vertex_groups.clear()
bpy.ops.export_scene.gltf(filepath=os.path.join(OUT, 'final_working.glb'), use_selection=True, export_format='GLB',
                          export_yup=True, export_apply=True,
                          export_materials='EXPORT', export_image_format='NONE', export_animations=False, export_skins=False)
st.hide_render = True; st.hide_set(True)
R['static_object'] = st.name
R['orb_centre_rest_m'] = [round(v, 4) for v in orb_c]       # the lens face's centre (the key keeps its old name)
R['open_axis'] = [round(v, 4) for v in OPEN_AXIS]
R['lens_axis'] = [round(v, 4) for v in LENS_AXIS]
R['light_ahead_m'] = LIGHT_AHEAD
# the same in the static pose, carried by the head bone (where UE puts the warm light), and the posed hood top
hm = rig.pose.bones['head'].matrix @ rig.data.bones['head'].matrix_local.inverted()
w_orb, w_ax = hm @ orb_c, (hm.to_3x3() @ OPEN_AXIS).normalized()
R['working'] = {'orb_centre_m': [round(v, 4) for v in w_orb], 'open_axis': [round(v, 4) for v in w_ax],
                'light_m': [round(v, 4) for v in w_orb + w_ax * LIGHT_AHEAD], 'top_z_m': round(max(v.co.z for v in st.data.vertices), 4)}
bpy.ops.wm.save_as_mainfile(filepath=os.path.join(WORK, 'agent.blend'))
json.dump(R, open(os.path.join(WORK, 'build.json'), 'w'), indent=1)
print('BUILD', json.dumps({k: R[k] for k in ('part_tris', 'bake_seconds', 'ao')}))
