# Blender script; run with blender -b -P scripts/art/materials/render_materials.bpy -- <repo-root> <work-dir>
"""Renders the evidence for the four tiling materials from their textures/*.png: evidence/tiled-2x2.jpg (a top-down orthographic
view of a plane that repeats the texture 2 x 2, so the wrap seams run through the middle of the image) and evidence/swatch.jpg
(the material on a plane seen at about 40 degrees under a raking area light, so normal and roughness show). Cycles on the CPU
(no GPU, no EEVEE), 24 samples, denoiser off. JPEG, 960 px."""
import bpy, math, os, sys
from mathutils import Vector

REPO, WORK = sys.argv[sys.argv.index('--') + 1:][:2]
IDS = ['vellum', 'blueprint-paper', 'brushed-aluminium', 'warm-wood']
# metres per tile; the swatch plane is 0.5 x 0.5 m at most
TILE_M = {'vellum': 0.5, 'blueprint-paper': 0.5, 'brushed-aluminium': 0.25, 'warm-wood': 0.5}


def build(mid, repeat, size):
    bpy.ops.wm.read_factory_settings(use_empty=True)
    S = bpy.context.scene
    S.render.engine = 'CYCLES'
    S.cycles.device = 'CPU'
    S.cycles.samples = 24
    S.cycles.use_denoising = False
    S.view_settings.view_transform = 'Standard'
    w = bpy.data.worlds.new('w')
    w.use_nodes = True
    w.node_tree.nodes['Background'].inputs['Color'].default_value = (0.35, 0.38, 0.45, 1)
    w.node_tree.nodes['Background'].inputs['Strength'].default_value = 0.25
    S.world = w
    tex = os.path.join(REPO, 'apps', 'vr', 'ArtSource', 'mat-' + mid, 'textures', mid)
    m = bpy.data.materials.new(mid)
    m.use_nodes = True
    nt = m.node_tree
    nt.nodes.clear()
    out = nt.nodes.new('ShaderNodeOutputMaterial')
    bsdf = nt.nodes.new('ShaderNodeBsdfPrincipled')
    nt.links.new(bsdf.outputs['BSDF'], out.inputs['Surface'])
    uv = nt.nodes.new('ShaderNodeTexCoord')
    mp = nt.nodes.new('ShaderNodeMapping')
    mp.inputs['Scale'].default_value = (repeat, repeat, 1)
    nt.links.new(uv.outputs['UV'], mp.inputs['Vector'])

    def image(suffix, cs):
        n = nt.nodes.new('ShaderNodeTexImage')
        n.image = bpy.data.images.load(tex + suffix)
        n.image.colorspace_settings.name = cs
        n.extension = 'REPEAT'
        n.interpolation = 'Cubic'
        nt.links.new(mp.outputs['Vector'], n.inputs['Vector'])
        return n
    bc = image('_basecolor.png', 'sRGB')
    nm = image('_normal.png', 'Non-Color')
    orm = image('_orm.png', 'Non-Color')
    nt.links.new(bc.outputs['Color'], bsdf.inputs['Base Color'])
    nmap = nt.nodes.new('ShaderNodeNormalMap')
    nt.links.new(nm.outputs['Color'], nmap.inputs['Color'])
    nt.links.new(nmap.outputs['Normal'], bsdf.inputs['Normal'])
    sep = nt.nodes.new('ShaderNodeSeparateColor')
    nt.links.new(orm.outputs['Color'], sep.inputs['Color'])
    nt.links.new(sep.outputs['Green'], bsdf.inputs['Roughness'])
    nt.links.new(sep.outputs['Blue'], bsdf.inputs['Metallic'])
    bpy.ops.mesh.primitive_plane_add(size=1)
    pl = bpy.context.object
    pl.scale = (size, size, 1)
    pl.data.materials.append(m)
    return S, pl


def cam(S, loc, target, ortho=None, fov=35):
    c = bpy.data.cameras.new('c')
    if ortho:
        c.type = 'ORTHO'
        c.ortho_scale = ortho
    else:
        c.sensor_width = 36
        c.lens = 18 / math.tan(math.radians(fov) / 2)
    o = bpy.data.objects.new('c', c)
    S.collection.objects.link(o)
    o.location = loc
    o.rotation_euler = (Vector(target) - Vector(loc)).to_track_quat('-Z', 'Y').to_euler()
    S.camera = o


def light(S, loc, target, energy, size):
    l = bpy.data.lights.new('l', 'AREA')
    l.energy = energy
    l.size = size
    o = bpy.data.objects.new('l', l)
    S.collection.objects.link(o)
    o.location = loc
    o.rotation_euler = (Vector(target) - Vector(loc)).to_track_quat('-Z', 'Y').to_euler()


def render(S, path, w, h):
    S.render.resolution_x, S.render.resolution_y = w, h
    S.render.image_settings.file_format = 'JPEG'
    S.render.image_settings.quality = 88
    S.render.filepath = path
    bpy.ops.render.render(write_still=True)


for mid in IDS:
    ev = os.path.join(REPO, 'apps', 'vr', 'ArtSource', 'mat-' + mid, 'evidence')
    os.makedirs(ev, exist_ok=True)
    t = TILE_M[mid]
    # 2 x 2 tiles, top-down orthographic, even light from above and slightly aside
    S, pl = build(mid, 2, 2 * t)
    cam(S, (0, 0, 2), (0, 0, 0), ortho=2 * t)
    light(S, (0.3, -0.3, 1.5), (0, 0, 0), 25, 2.0)
    render(S, os.path.join(ev, 'tiled-2x2.jpg'), 960, 960)
    # lit swatch: one plane, 40 degrees, raking light
    S, pl = build(mid, 1, 2 * t)
    d = 1.6 * t * 2
    cam(S, (0, -d * math.cos(math.radians(40)), d * math.sin(math.radians(40))), (0, 0, 0), fov=35)
    light(S, (-0.6, -0.15, 0.35), (0, 0, 0), 18, 0.5)
    render(S, os.path.join(ev, 'swatch.jpg'), 960, 640)
    print('rendered', mid)
